Options -Indexes

<IfModule mod_php7.c>
    php_flag display_errors off
</IfModule>

# Запрет прямого доступа к служебным файлам
<FilesMatch "\.(sql|sh|log|md)$">
    Require all denied
</FilesMatch>

<Files "config.php">
    Require all denied
</Files>

# Сжатие ответов — статика (CSS/JS/шрифты/иконки) и HTML/JSON заметно
# быстрее грузятся на мобильной сети сотрудников/IT-отдела.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/manifest+json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Долгое кэширование в браузере для статических файлов — CSS/JS/картинки
# не меняются на каждый визит, а если понадобится обновить — достаточно
# переименовать файл (версионировать) или дождаться истечения срока.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/manifest+json "access plus 1 day"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|png|jpe?g|gif|webp|svg|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>
